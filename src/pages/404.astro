---
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLang } from '../i18n/ui';
import { localizedPath, locales, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = defaultLang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path="/404" title={t('404.title')}>
  <div class="page wrap">
    <p class="eyebrow">404</p>
    <h1>{t('404.title')}</h1>
    <p class="text">{t('404.text')}</p>
    <ul class="links">
      {locales.map((code) => (
        <li>
          <a href={localizedPath('/', code)}>
            {languages[code]} — {localizedPath('/', code)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-block: 90px 120px;
    max-width: 62ch;
  }

  h1 {
    font-size: clamp(30px, 5vw, 46px);
    line-height: 1.04;
    margin-top: 14px;
  }

  .text {
    color: var(--ink-soft);
    font-size: 18px;
    margin-top: 18px;
  }

  .links {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--f-mono);
    font-size: 13px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }

  .links a {
    color: var(--accent-deep);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
