---
import { getEntry, render } from 'astro:content';
import '../../styles/print.css';
import type { Lang } from '../../i18n/ui';
import { langStaticPaths, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import StackRows from '../../components/StackRows.astro';
import ExperienceList from '../../components/ExperienceList.astro';
import Prose from '../../components/Prose.astro';

export const getStaticPaths = langStaticPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const profile = await getEntry('profile', lang);
const data = profile?.data;

const { Content } = profile ? await render(profile) : { Content: null };
const hasBody =
  profile?.body !== undefined && profile.body.replace(/<!--[\s\S]*?-->/g, '').trim() !== '';

const contacts = [
  ...(data?.email ? [{ label: data.email, url: `mailto:${data.email}` }] : []),
  ...(data?.links ?? []),
];
---

<BaseLayout lang={lang} path="/cv" title={t('cv.title')} description={data?.description}>
  <div class="page cv">
    <header class="cv-head">
      <div>
        <h1>{data?.name || 'Maksym Sytkiv'}</h1>
        {data?.headline && <p class="headline">{data.headline}</p>}
      </div>

      <div class="cv-actions">
        <button class="print-btn" type="button" data-print>
          {t('cv.print')}
        </button>
      </div>
    </header>

    {(contacts.length > 0 || data?.location) && (
      <p class="contacts">
        {data?.location && <span>{data.location}</span>}
        {contacts.map((contact) => (
          <a href={contact.url} rel="noopener">
            {contact.label}
          </a>
        ))}
      </p>
    )}

    {hasBody && Content && (
      <section>
        <SectionHead title={t('cv.summary')} />
        <Prose>
          <Content />
        </Prose>
      </section>
    )}

    {data && data.experience.length > 0 && (
      <section>
        <SectionHead title={t('cv.experience')} />
        <ExperienceList jobs={data.experience} variant="full" />
      </section>
    )}

    {data && data.skills.length > 0 && (
      <section>
        <SectionHead title={t('cv.skills')} />
        <StackRows groups={data.skills} />
      </section>
    )}

    {data && data.education.length > 0 && (
      <section>
        <SectionHead title={t('cv.education')} />
        <ul class="plain">
          {data.education.map((item) => (
            <li>
              <span class="plain-main">
                <b>{item.institution}</b> — {item.degree}
              </span>
              <span class="plain-meta num">{item.period}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {data && data.languages.length > 0 && (
      <section>
        <SectionHead title={t('cv.languages')} />
        <ul class="plain">
          {data.languages.map((item) => (
            <li>
              <span class="plain-main">{item.name}</span>
              <span class="plain-meta">{item.level}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const btn = document.querySelector('[data-print]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      window.print();
    });
  })();
</script>

<style>
  .cv {
    max-width: 900px;
    margin-inline: auto;
    padding-bottom: 26px;
  }

  .cv-head {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom: 1px solid var(--ink);
    padding: 46px 0 20px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1;
    font-weight: 800;
  }

  .headline {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(17px, 2.2vw, 22px);
    color: var(--ink-soft);
    margin-top: 10px;
  }

  .print-btn {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface);
    background: var(--accent);
    border: none;
    padding: 10px 16px;
    cursor: pointer;
    border-radius: 2px;
  }

  .print-btn:hover {
    filter: brightness(1.08);
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 18px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--ink-faint);
  }

  .contacts a {
    color: var(--accent-deep);
    text-decoration: none;
  }

  .contacts a:hover {
    text-decoration: underline;
  }

  .cv section {
    margin-top: 52px;
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .plain li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    justify-content: space-between;
    align-items: baseline;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .plain li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .plain-main {
    font-size: 16px;
  }

  .plain-main b {
    font-weight: 600;
  }

  .plain-meta {
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--ink-faint);
  }
</style>
