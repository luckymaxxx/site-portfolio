---
interface Pain {
  pain: string;
  solution: string;
}

interface Props {
  rows: Pain[];
  headLeft: string;
  headRight: string;
}

const { rows, headLeft, headRight } = Astro.props;
---

<div class="scroll-x">
  <table>
    <thead>
      <tr>
        <th scope="col">{headLeft}</th>
        <th scope="col">{headRight}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td>{row.pain}</td>
          <td>{row.solution}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15.5px;
    min-width: 560px;
  }

  thead th {
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 500;
    text-align: left;
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--line);
  }

  tbody td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--line-soft);
    vertical-align: top;
    line-height: 1.5;
  }

  tbody td:first-child {
    width: 38%;
    color: var(--ink-soft);
    font-style: italic;
  }

  tbody td:last-child {
    padding-right: 0;
  }

  tbody tr:last-child td {
    border-bottom: 1px solid var(--line);
  }
</style>
