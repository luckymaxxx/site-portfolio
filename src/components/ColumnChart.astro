---
interface Point {
  label: string;
  value: number;
  partial?: boolean;
}

interface Props {
  title: string;
  note?: string | undefined;
  /** Верхня межа шкали Y. */
  max: number;
  /** 2–3 підписи осі X. */
  axis: string[];
  data: Point[];
}

const { title, note, max, axis, data } = Astro.props;

const safeMax = max > 0 ? max : Math.max(...data.map((point) => point.value), 1);
const half = Math.round(safeMax / 2);

// Текстовий еквівалент графіка для скрінрідерів і пошуковиків.
const summary = `${title}: ${data.map((point) => `${point.label} — ${point.value}`).join(', ')}`;
---

<figure class="chart">
  <figcaption class="chart-title">{title}</figcaption>

  <div class="cols" role="img" aria-label={summary}>
    <div class="y-axis num" aria-hidden="true">
      <span>{safeMax}</span>
      <span>{half}</span>
      <span>0</span>
    </div>

    <div class="plot">
      {data.map((point) => (
        <div
          class:list={['bar', { partial: point.partial }]}
          style={`height:${((point.value / safeMax) * 100).toFixed(1)}%`}
          title={`${point.label} · ${point.value}`}
        />
      ))}
    </div>

    <div class="x-axis" aria-hidden="true">
      {axis.map((label) => (
        <span>{label}</span>
      ))}
    </div>
  </div>

  {note && <p class="chart-note">{note}</p>}
</figure>

<style>
  .chart {
    margin: 0;
  }

  .chart-title {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 20px;
  }

  .cols {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 0 10px;
  }

  .y-axis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 150px;
    font-family: var(--f-mono);
    font-size: 10px;
    color: var(--ink-faint);
    text-align: right;
  }

  .y-axis span {
    transform: translateY(-0.45em);
  }

  .plot {
    height: 150px;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    border-bottom: 1px solid var(--ink-soft);
    background-image:
      linear-gradient(
        to top,
        transparent 49.5%,
        var(--line) 49.5%,
        var(--line) calc(49.5% + 1px),
        transparent calc(49.5% + 1px)
      ),
      linear-gradient(
        to top,
        transparent 99.4%,
        var(--line) 99.4%,
        var(--line) 100%,
        transparent 100%
      );
  }

  .bar {
    flex: 1;
    background: var(--accent);
    min-width: 6px;
  }

  .bar.partial {
    background: repeating-linear-gradient(135deg, var(--accent) 0 3px, transparent 3px 6px);
    border-top: 2px solid var(--accent);
  }

  .x-axis {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    font-family: var(--f-mono);
    font-size: 10px;
    color: var(--ink-faint);
    margin-top: 8px;
  }

  .chart-note {
    font-size: 13.5px;
    color: var(--ink-faint);
    margin-top: 14px;
    line-height: 1.45;
  }
</style>
