---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { formatPeriod, useTranslations } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  /** Мова сторінки, з якої показується картка. */
  lang: Lang;
  href: string;
  variant?: 'featured' | 'compact';
  /** Помітка, якщо кейс доступний лише мовою оригіналу. */
  langNote?: string | null | undefined;
}

const { project, lang, href, variant = 'compact', langNote } = Astro.props;
const t = useTranslations(lang);

const period = formatPeriod(project.periodStart, project.periodEnd, project.lang);
const figures = project.figures.slice(0, 3);
const keyStack = project.stack
  .flatMap((group) => group.items)
  .filter((item) => item.key)
  .slice(0, 8);
---

{
  variant === 'featured' ? (
    <article class="featured">
      {project.cover && (
        <a class="cover" href={href} tabindex="-1" aria-hidden="true">
          <img src={project.cover} alt="" width="1600" height="900" loading="lazy" decoding="async" />
        </a>
      )}

      <div class="body">
        <div class="top">
          {project.domain && <span class="eyebrow">{project.domain}</span>}
          <span class="period num">{period}</span>
        </div>

        <h3>
          <a href={href}>{project.title}</a>
        </h3>

        <p class="tagline">{project.tagline}</p>

        {langNote && <p class="lang-note">{langNote}</p>}

        {figures.length > 0 && (
          <dl class="mini-figures">
            {figures.map((figure) => (
              <div>
                <dt>{figure.label}</dt>
                <dd class="num">{figure.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {keyStack.length > 0 && (
          <div class="chips">
            {keyStack.map((item) => (
              <span class="chip">{item.name}</span>
            ))}
          </div>
        )}

        <a class="read" href={href}>
          {t('card.read')}
        </a>
      </div>
    </article>
  ) : (
    <a class="row" href={href}>
      <span class="row-main">
        <span class="row-title">{project.title}</span>
        <span class="row-tagline">{project.tagline}</span>
        {langNote && <span class="lang-note">{langNote}</span>}
      </span>
      <span class="row-meta num">{period}</span>
    </a>
  )
}

<style>
  /* ---------- велика картка ---------- */

  .featured {
    border: 1px solid var(--line);
    background: var(--surface);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .cover {
    display: block;
    border-bottom: 1px solid var(--line);
    background: var(--surface-sunk);
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .body {
    padding: 26px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  .period {
    font-family: var(--f-mono);
    font-size: 11.5px;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .featured h3 {
    font-size: clamp(24px, 3.4vw, 32px);
    line-height: 1.05;
  }

  .featured h3 a {
    text-decoration: none;
  }

  .featured h3 a:hover {
    color: var(--accent-deep);
  }

  .tagline {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .lang-note {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .mini-figures {
    margin: 4px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .mini-figures > div {
    flex: 1 1 130px;
    padding: 12px 16px 14px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .mini-figures dt {
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 7px;
  }

  .mini-figures dd {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .chip {
    font-family: var(--f-mono);
    font-size: 12px;
    line-height: 1;
    padding: 6px 9px;
    border: 1px solid var(--accent);
    color: var(--accent-deep);
    background: var(--accent-soft);
    border-radius: 2px;
  }

  .read {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--accent-deep);
    text-decoration: none;
    margin-top: 4px;
    align-self: flex-start;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 3px;
  }

  .read::after {
    content: ' →';
  }

  .read:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* ---------- компактний рядок ---------- */

  .row {
    display: flex;
    gap: 12px 28px;
    align-items: baseline;
    justify-content: space-between;
    padding: 18px 0;
    border-bottom: 1px solid var(--line-soft);
    text-decoration: none;
  }

  .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .row:hover .row-title {
    color: var(--accent-deep);
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .row-title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  .row-tagline {
    color: var(--ink-soft);
    font-size: 15.5px;
    line-height: 1.45;
    max-width: 62ch;
  }

  .row-meta {
    font-family: var(--f-mono);
    font-size: 11.5px;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .body {
      padding: 22px 20px 24px;
    }
    .row {
      flex-direction: column;
    }
  }
</style>
